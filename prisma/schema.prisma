generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
}

enum CategoryKind {
    AREA
    PROFILE
}

enum TransactionType {
    EXPENSE
    INCOME
}

enum ImportSource {
    XP
    BTG
    BB
}

enum ImportBatchStatus {
    COMPLETED
    PARTIAL
    FAILED
}

model User {
    id           String   @id @default(cuid())
    email        String   @unique
    name         String
    passwordHash String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    householdMembership HouseholdMember?
    expenses            Expense[]
    responsibleExpenses Expense[]        @relation("ExpenseResponsibleUser")
    income              Income[]
    ownedIncome         Income[]         @relation("IncomeOwnerUser")
    importBatches       ImportBatch[]    @relation("ImportBatchCreator")
}

model Household {
    id        String   @id @default(cuid())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    members       HouseholdMember[]
    expenses      Expense[]
    importBatches ImportBatch[]
    payableItems  PayableItem[]
    categories    Category[]
}

model PayableItem {
    id          String    @id @default(cuid())
    householdId String
    name        String
    defaultKey  String?
    sortOrder   Int
    createdAt   DateTime  @default(now())
    archivedAt  DateTime?

    household      Household                    @relation(fields: [householdId], references: [id], onDelete: Cascade)
    monthlyStatuses PayableItemMonthlyStatus[]

    @@unique([householdId, defaultKey])
    @@index([householdId, archivedAt, sortOrder])
}

model PayableItemMonthlyStatus {
    id            String   @id @default(cuid())
    payableItemId String
    year          Int
    month         Int
    isPaid        Boolean  @default(false)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    payableItem PayableItem @relation(fields: [payableItemId], references: [id], onDelete: Cascade)

    @@unique([payableItemId, year, month])
}

model HouseholdMember {
    id          String   @id @default(cuid())
    householdId String
    userId      String   @unique
    createdAt   DateTime @default(now())

    household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([householdId, userId])
}

model Category {
    id          String          @id @default(cuid())
    householdId String?
    name        String
    kind        CategoryKind
    type        TransactionType
    color       String
    icon        String?
    sortOrder   Int             @default(0)
    archivedAt  DateTime?
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    expensesAsArea    Expense[]         @relation("ExpenseAreaCategory")
    expensesAsProfile Expense[]         @relation("ExpenseProfileCategory")
    areaSubcategories AreaSubcategory[]
    budgets           Budget[]
    household         Household?        @relation(fields: [householdId], references: [id], onDelete: Cascade)

    @@unique([householdId, name, kind], map: "Category_householdId_name_kind_key")
    @@index([householdId, kind, type, archivedAt, sortOrder], map: "Category_household_category_order_idx")
}

model Expense {
    id                        String    @id @default(cuid())
    description               String
    amount                    Decimal   @db.Decimal(10, 2)
    creditCardTransactionDate DateTime? @db.Date
    date                      DateTime  @db.Date
    householdId               String
    areaCategoryId            String
    areaSubcategoryId         String
    profileCategoryId         String
    userId                    String
    responsibleUserId         String
    importBatchId             String?
    importFingerprint         String?
    importRowNumber           Int?
    importMetadata            Json?
    notes                     String?
    recurring                 Boolean   @default(false)
    shared                    Boolean   @default(false)
    createdAt                 DateTime  @default(now())
    updatedAt                 DateTime  @updatedAt

    household       Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
    areaCategory    Category        @relation("ExpenseAreaCategory", fields: [areaCategoryId], references: [id], onDelete: Restrict)
    areaSubcategory AreaSubcategory @relation(fields: [areaSubcategoryId], references: [id], onDelete: Restrict)
    profileCategory Category        @relation("ExpenseProfileCategory", fields: [profileCategoryId], references: [id], onDelete: Restrict)
    user            User            @relation(fields: [userId], references: [id])
    responsibleUser User            @relation("ExpenseResponsibleUser", fields: [responsibleUserId], references: [id])
    importBatch     ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

    @@index([householdId, date])
    @@index([date, amount])
    @@index([householdId, importFingerprint])
    @@index([importBatchId])
}

model ImportBatch {
    id              String            @id @default(cuid())
    householdId     String
    userId          String
    source          ImportSource
    fileName        String
    fileFingerprint String
    statementDate   DateTime?         @db.Date
    status          ImportBatchStatus
    totalRows       Int
    importedRows    Int
    ignoredRows     Int               @default(0)
    skippedRows     Int               @default(0)
    failedRows      Int               @default(0)
    createdAt       DateTime          @default(now())
    updatedAt       DateTime          @updatedAt

    household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
    user      User      @relation("ImportBatchCreator", fields: [userId], references: [id], onDelete: Restrict)
    expenses  Expense[]

    @@index([householdId, createdAt])
    @@index([householdId, fileFingerprint])
}

model AreaSubcategory {
    id             String   @id @default(cuid())
    name           String
    areaCategoryId String
    archivedAt     DateTime?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    areaCategory Category  @relation(fields: [areaCategoryId], references: [id], onDelete: Restrict)
    expenses     Expense[]

    @@unique([areaCategoryId, name])
    @@index([areaCategoryId, archivedAt], map: "AreaSubcategory_active_idx")
}

model Income {
    id          String   @id @default(cuid())
    description String
    amount      Decimal  @db.Decimal(10, 2)
    date        DateTime
    userId      String
    ownerUserId String
    notes       String?
    recurring   Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user      User @relation(fields: [userId], references: [id])
    ownerUser User @relation("IncomeOwnerUser", fields: [ownerUserId], references: [id])
}

model Budget {
    id         String   @id @default(cuid())
    categoryId String
    amount     Decimal  @db.Decimal(10, 2)
    month      Int
    year       Int
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

    @@unique([categoryId, month, year])
}
